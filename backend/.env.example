# ---- Backend environment ----
# Supabase project URL + SERVICE ROLE key.
# The service_role key must ONLY live on the server. Never put it in frontend code.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Direct Postgres connection used by: npm run migrate
# Prefer the Session pooler URI if the direct db.* host is IPv6-only.
# Format: postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Supabase Storage (S3 protocol) — Project Settings → Storage → S3 access keys
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
S3_ENDPOINT=https://YOUR-PROJECT.storage.supabase.co/storage/v1/s3
S3_REGION=ca-central-1
S3_BUCKET=property-images

# Used only for local Express development. Netlify supplies its own runtime port.
PORT=4000

# Local frontend origin. For production you can use your Netlify URL.
# Multiple allowed origins may be comma-separated.
CLIENT_ORIGIN=http://localhost:5173
