# ---- Frontend environment ----
# Cesium ion browser token. On Netlify, add this as an environment variable
# so Vite can inject it at build time.
VITE_CESIUM_ION_TOKEN=YOUR_CESIUM_ION_TOKEN

# Local development API URL. Leave this UNSET in Netlify so the frontend uses
# same-origin /api routes that are rewritten to the Netlify Express function.
VITE_API_BASE_URL=http://localhost:4000
